# ==============================================================================
# Padjadjaran Suites Resort & Convention Hotel Bogor
# Environment Configuration Template
# ==============================================================================

# Payload CMS Secret Key (Ganti dengan string random aman di server VPS)
PAYLOAD_SECRET=your_super_secret_payload_key_replace_in_production

# Database Connection:
# - Untuk Development Lokal: file:./payload.db (SQLite)
# - Untuk Server VPS Produksi: postgresql://postgres:password@postgres:5432/padjadjaran_db
DATABASE_URI=file:./payload.db

# Domain URL Publik (Ganti dengan domain hotel Anda, misal https://padjadjaransuitesresort.com)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Midtrans Payment Gateway Configuration
# Dapatkan Client Key & Server Key dari https://dashboard.midtrans.com/
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Akun Super Admin Awal (Digunakan saat pertama kali seeding)
ADMIN_INITIAL_EMAIL=admin@padjadjaransuitesresort.com
ADMIN_INITIAL_PASSWORD=GantiPasswordKuat2026!
